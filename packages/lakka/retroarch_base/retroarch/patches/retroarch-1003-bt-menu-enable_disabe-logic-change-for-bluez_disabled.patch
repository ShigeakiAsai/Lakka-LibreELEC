 #endif
@@ -4411,7 +4412,8 @@ static bool config_load_file(global_t *global,
    configuration_set_bool(settings,
          settings->bools.samba_enable, !filestream_exists(LAKKA_SAMBA_DISABLED_FILE_PATH));
    configuration_set_bool(settings,
-         settings->bools.bluetooth_enable, filestream_exists(LAKKA_BLUETOOTH_PATH));
+         settings->bools.bluetooth_enable,
+         filestream_exists(LAKKA_BLUETOOTH_PATH) && !filestream_exists(LAKKA_BLUETOOTH_DISABLED_FILE_PATH));
 #endif
 
    if (    !retroarch_override_setting_is_set(RARCH_OVERRIDE_SETTING_SAVE_PATH, NULL)
@@ -5665,11 +5667,16 @@ bool config_save_file(const char *path)
                RETRO_VFS_FILE_ACCESS_WRITE,
                RETRO_VFS_FILE_ACCESS_HINT_NONE));
    if (settings->bools.bluetooth_enable)
+   {
+      filestream_delete(LAKKA_BLUETOOTH_DISABLED_FILE_PATH);
       filestream_close(filestream_open(LAKKA_BLUETOOTH_PATH,
-               RETRO_VFS_FILE_ACCESS_WRITE,
+               RETRO_VFS_FILE_ACCESS_READ_WRITE | RETRO_VFS_FILE_ACCESS_UPDATE_EXISTING,
