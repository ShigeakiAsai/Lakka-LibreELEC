diff --git a/menu/menu_setting.c b/menu/menu_setting.c
index 52d6c50071..17eac02e96 100644
--- a/menu/menu_setting.c
+++ b/menu/menu_setting.c
@@ -9202,6 +9202,11 @@ static void update_streaming_url_write_handler(rarch_setting_t *setting)
 #ifdef HAVE_LAKKA
 static void systemd_service_toggle(const char *path, char *unit, bool enable)
 {
+   /* bluetooth, samba, and SSH are all different.
+    * This is for ssh.
+    * ssh.service is enabled when "/storage/.cache/services/sshd.conf" file is exist.
+    * So, create(enabled) or remove(disabled) this file and start/stop service. */
+
    pid_t pid    = fork();
    char* args[] = {(char*)"systemctl",
                    enable ? (char*)"start" : (char*)"stop",
@@ -9223,11 +9228,10 @@ static void systemd_service_toggle(const char *path, char *unit, bool enable)
 
 static void systemd_samba_service_toggle(const char *path, char *unit, bool enable)
 {
-   /* There is difference between samba and ssh/bluetooth.
-    * - samba.service is disabled if "/storage/.cache/services/samba.disabled" file is exist.
-    * - ssh.service is enabled if "/storage/.cache/services/sshd.conf" file is exist.
-    * - bluetooth.service is enabled if "/storage/.cache/services/bluez.conf" file is exist.
-    * So it separates the systemd_service_toggle for samba.service. */
+   /* bluetooth, samba, and SSH are all different.
+    * This is for samba.
+    * samba.service will be disabled if "/storage/.cache/services/samba.disabled" file is exist.
+    * So, remove(enabled) or create(disabled) "samba.disabled" file and start/stop service. */
 
    pid_t pid    = fork();
    char* args[] = {(char*)"systemctl",
@@ -9248,6 +9252,48 @@ static void systemd_samba_service_toggle(const char *path, char *unit, bool enab
    }
 }
 
+static void systemd_bluetooth_service_toggle(const char *path_disabled, const char *path_conf, char *unit, bool enable)
+{
+   /* bluetooth, samba, and SSH are all different.
+    * This is used for bluetooth.
+    * 1) bluetooth.service will be disabled if "/storage/.cache/services/bluez.disabled" file is exist.
+    *    - if enabled - it removes "bluez.disabled" file.
+    *    - if disabled - it creates "bluez.disabled" file.
+    *    So, remove(enabled) or create(disabled) "bluez.disabled" file.
+    * 2) bluetooth.service will be enabled if "/storage/.cache/services/bluez.conf" file is exist.
+    *    - if enabled - it checks "bluez.conf" file exist.
+    *      if "bluez.conf" file is not exist, it restarts "bluetooth-defaults.service" for default file restore
+    *      and wait 0.5 sec.
+    *    - if disabled - it keeps current "bluez.conf" file for re-enable.
+    * 3) start/stop "bluetooth.service"
+    */
+
+   pid_t pid    = fork();
+   char* args[] = {(char*)"systemctl",
+                   enable ? (char*)"start" : (char*)"stop",
+                   unit,
+                   NULL};
+
+   if (pid == 0)
+   {
+      if (enable)
+      {
+         filestream_delete(path_disabled);
+         if (!filestream_exists(path_conf))
+         {
+            system("systemctl restart bluetooth-defaults.service");
+            system("sleep 0.5");
+         }
+      }
+      else
+         filestream_close(filestream_open(path_disabled,
+                  RETRO_VFS_FILE_ACCESS_WRITE,
+                  RETRO_VFS_FILE_ACCESS_HINT_NONE));
+
+      execvp(args[0], args);
+   }
+}
+
 #ifdef HAVE_LAKKA_SWITCH
 static void switch_oc_enable_toggle_change_handler(rarch_setting_t *setting)
 {
@@ -9304,7 +9350,8 @@ static void samba_enable_toggle_change_handler(rarch_setting_t *setting)
 static void bluetooth_enable_toggle_change_handler(
       rarch_setting_t *setting)
 {
-   systemd_service_toggle(LAKKA_BLUETOOTH_PATH,
+   systemd_bluetooth_service_toggle(LAKKA_BLUETOOTH_DISABLED_FILE_PATH,
+          LAKKA_BLUETOOTH_PATH,
          (char*)"bluetooth.service",
          *setting->value.target.boolean);
 }
