     * buffer that outlives the load */
    bool                         owned;
    bool                         cancelled;
+   /* The slot holds a texture that stays drawn until this one lands,
+    * and is unloaded then */
+   bool                         replace;
 } gfx_display_tex_load_t;
 
 /* Main thread only, as surface submits and their completions are */
@@ -1653,6 +1656,8 @@
    /* A handle of 0 is a load the driver refused or a teardown */
    if (!e->cancelled && s->handle)
    {
+      if (e->replace && *e->item)
+         video_driver_texture_unload(e->item);
       *e->item  = s->handle;
       s->handle = 0;
    }
@@ -1679,8 +1684,10 @@
 }
 
 static bool gfx_display_texture_load_ex(struct texture_image *ti,
-      enum texture_filter_type filter, uintptr_t *item, bool owned)
+      enum texture_filter_type filter, uintptr_t *item, bool owned,
+      bool replace)
 {
+   uintptr_t tex = 0;
 #ifdef HAVE_THREADS
    if (     ti && item && ti->pixels && !ti->compressed && !ti->pix10
          && VIDEO_SCALE_FITS(ti->width, ti->height)
@@ -1700,6 +1707,7 @@
          e->item          = item;
          e->img           = *ti;
          e->owned         = owned;
+         e->replace       = replace;
          /* The entry frees the pixels from its release, which always
           * runs: a display load's surface is only freed there. */
          src.pixels       = ti->pixels;
@@ -1720,6 +1728,8 @@
          }
          if (r == GFX_SURFACE_SUBMIT_DONE)
          {
+            if (replace && *item)
+               video_driver_texture_unload(item);
             *item     = s->handle;
             s->handle = 0;
             gfx_surface_free(s);
@@ -1731,13 +1741,32 @@
       gfx_surface_free(s);
    }
 #endif
-   return video_driver_texture_load(ti, filter, item);
+   if (!replace)
+      return video_driver_texture_load(ti, filter, item);
+
+   /* Load first, so the old texture is only unloaded once there is
+    * one to take its place */
+   if (!video_driver_texture_load(ti, filter, &tex))
+      return false;
+#ifdef HAVE_THREADS
+   gfx_display_texture_loads_cancel(item, sizeof(*item));
+#endif
+   if (*item)
+      video_driver_texture_unload(item);
+   *item = tex;
+   return true;
 }
 
 bool gfx_display_texture_load(struct texture_image *ti,
       enum texture_filter_type filter, uintptr_t *item)
 {
-   return gfx_display_texture_load_ex(ti, filter, item, true);
+   return gfx_display_texture_load_ex(ti, filter, item, true, false);
+}
+
+bool gfx_display_texture_replace(struct texture_image *ti,
+      enum texture_filter_type filter, uintptr_t *item)
+{
+   return gfx_display_texture_load_ex(ti, filter, item, true, true);
 }
 
