+ *
+ *  You should have received a copy of the GNU General Public License along with RetroArch.
+ *  If not, see <http://www.gnu.org/licenses/>.
+ */
+
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <glob.h>
+
+#include "../runloop.h"
+#include "../libretro-common/include/retro_miscellaneous.h"
+
+#include "lakka_mount.h"
+
+void lakka_check_configured_mounts(void)
+{
+   glob_t glob_result;
+   char pattern[PATH_MAX_LENGTH];
+   char list_msg[PATH_MAX_LENGTH];
+   size_t i;
+   size_t list_len = 0;
+   unsigned unmounted_count = 0;
+
+   snprintf(pattern, sizeof(pattern), "%s*.mount", LAKKA_SYSTEM_D_DIR);
+
+   if (glob(pattern, GLOB_NOSORT, NULL, &glob_result) != 0)
+      return;  /* no *.mount files configured */
+
+   list_msg[0] = '\0';
+
+   for (i = 0; i < glob_result.gl_pathc; i++)
+   {
+      const char *full_path = glob_result.gl_pathv[i];
+      const char *unit_name = strrchr(full_path, '/');
+      char cmd[512];
+
+      unit_name = unit_name ? unit_name + 1 : full_path;
+
+      snprintf(cmd, sizeof(cmd), "systemctl is-active --quiet -- %s", unit_name);
+      if (system(cmd) != 0)
+      {
+         if (unmounted_count < LAKKA_UNMOUNTED_LIST_THRESHOLD)
+         {
+            int written = snprintf(list_msg + list_len, sizeof(list_msg) - list_len,
+                  "%s%s", unmounted_count > 0 ? ", " : "", unit_name);
+            if (written > 0 && (size_t)written < sizeof(list_msg) - list_len)
+               list_len += (size_t)written;
+         }
+         unmounted_count++;
+      }
+   }
+
+   globfree(&glob_result);
+
+   if (unmounted_count > 0)
+   {
+      char full_msg[PATH_MAX_LENGTH];
+
+      if (unmounted_count <= LAKKA_UNMOUNTED_LIST_THRESHOLD)
+         snprintf(full_msg, sizeof(full_msg), "NAS not mounted: %s", list_msg);
+      else
+         snprintf(full_msg, sizeof(full_msg),
+               "NAS not mounted: %u units (see journalctl for details)",
+               unmounted_count);
+
+      runloop_msg_queue_push(full_msg, strlen(full_msg), 1, 180, true, NULL,
+            MESSAGE_QUEUE_ICON_DEFAULT, MESSAGE_QUEUE_CATEGORY_WARNING);
+   }
+}
+
+void lakka_retry_configured_mounts(void)
+{
+   glob_t glob_result;
+   char pattern[PATH_MAX_LENGTH];
+   char list_msg[PATH_MAX_LENGTH];
+   size_t i;
+   size_t list_len = 0;
+   unsigned retried_count = 0;
+
+   snprintf(pattern, sizeof(pattern), "%s*.mount", LAKKA_SYSTEM_D_DIR);
+
+   if (glob(pattern, GLOB_NOSORT, NULL, &glob_result) != 0)
+   {
+      const char *msg = "No NAS mount units configured";
+      runloop_msg_queue_push(msg, strlen(msg), 1, 180, true, NULL,
+            MESSAGE_QUEUE_ICON_DEFAULT, MESSAGE_QUEUE_CATEGORY_INFO);
+      return;
+   }
+
+   list_msg[0] = '\0';
+
+   for (i = 0; i < glob_result.gl_pathc; i++)
+   {
+      const char *full_path = glob_result.gl_pathv[i];
+      const char *unit_name = strrchr(full_path, '/');
+      char cmd[512];
+
+      unit_name = unit_name ? unit_name + 1 : full_path;
+
+      snprintf(cmd, sizeof(cmd), "systemctl is-active --quiet -- %s", unit_name);
+      if (system(cmd) == 0)
+         continue;  /* already mounted, nothing to retry */
+
+      snprintf(cmd, sizeof(cmd), "systemctl restart --no-block -- %s", unit_name);
+      system(cmd);
+
+      if (retried_count < LAKKA_UNMOUNTED_LIST_THRESHOLD)
+      {
+         int written = snprintf(list_msg + list_len, sizeof(list_msg) - list_len,
+               "%s%s", retried_count > 0 ? ", " : "", unit_name);
+         if (written > 0 && (size_t)written < sizeof(list_msg) - list_len)
+            list_len += (size_t)written;
+      }
+      retried_count++;
+   }
+
+   globfree(&glob_result);
+
+   {
+      char full_msg[PATH_MAX_LENGTH];
+
+      if (retried_count == 0)
+         snprintf(full_msg, sizeof(full_msg), "All NAS mounts already active");
+      else if (retried_count <= LAKKA_UNMOUNTED_LIST_THRESHOLD)
+         snprintf(full_msg, sizeof(full_msg), "Retrying NAS mount: %s", list_msg);
+      else
+         snprintf(full_msg, sizeof(full_msg),
+               "Retrying NAS mounts: %u units (see journalctl for details)",
+               retried_count);
+
+      runloop_msg_queue_push(full_msg, strlen(full_msg), 1, 180, true, NULL,
+            MESSAGE_QUEUE_ICON_DEFAULT, MESSAGE_QUEUE_CATEGORY_INFO);
+   }
+}
