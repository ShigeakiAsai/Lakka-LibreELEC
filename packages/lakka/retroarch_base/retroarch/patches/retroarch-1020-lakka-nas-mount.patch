diff -uNr a/network/lakka_mount.c b/network/lakka_mount.c
--- a/network/lakka_mount.c	1970-01-01 09:00:00.000000000 +0900
+++ b/network/lakka_mount.c	2026-09-22 13:57:49.621894614 +0900
@@ -0,0 +1,145 @@
+/*  RetroArch - A frontend for libretro.
+ *  Copyright (C) 2026-present - ShigeakiAsai
+ *
+ *  RetroArch is free software: you can redistribute it and/or modify it under the terms
+ *  of the GNU General Public License as published by the Free Software Found-
