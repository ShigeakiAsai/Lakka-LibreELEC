# RTL8812BU, RTL8811CU, MT7612U and more
ACTION=="add", SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_device", ATTRS{idVendor}=="0bda", ATTRS{idProduct}=="1a2b", RUN+="/usr/bin/logger -t usb-modeswitch-lakka 'udev rule matched: 0bda:1a2b'", RUN+="/usr/sbin/usb_modeswitch -K -v 0bda -p 1a2b"
ACTION=="add", SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_device", ATTRS{idVendor}=="0e8d", ATTRS{idProduct}=="2870", RUN+="/usr/bin/logger -t usb-modeswitch-lakka 'udev rule matched: 0e8d:2870'", RUN+="/usr/sbin/usb_modeswitch -K -v 0e8d -p 2870"
