[Unit]
Description=Lakka Mount Agent - retries network .mount units when IPv4 becomes available
After=connman.service
ConditionPathExistsGlob=/storage/.config/system.d/*.mount

[Service]
ExecStart=/usr/bin/lakka-mount-agent
Restart=always
RestartSec=5
StartLimitInterval=0

[Install]
WantedBy=multi-user.target
