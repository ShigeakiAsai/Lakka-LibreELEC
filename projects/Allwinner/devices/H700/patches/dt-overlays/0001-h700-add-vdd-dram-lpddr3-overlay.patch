+// SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+/*
+ * Copyright (C) 2024 Philippe Simons <simons.philippe@gmail.com>.
+ *
+ * Locks the AXP717 dcdc3 (vdd-dram) rail to a fixed 1.2V for Anbernic
+ * H700 boards fitted with LPDDR3 memory instead of the default LPDDR4.
+ * Stacks with any panel overlay already selected via FDTOVERLAYS.
+ */
+
+/dts-v1/;
+/plugin/;
+
+&reg_dcdc3 {
+	regulator-min-microvolt = <1200000>;
+	regulator-max-microvolt = <1200000>;
+};
