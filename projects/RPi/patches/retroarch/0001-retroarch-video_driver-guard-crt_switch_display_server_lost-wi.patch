From 53301439ed5f65480be74345f8e8f2f47225811a Mon Sep 17 00:00:00 2001
From: Shigeaki Asai <y-asai.0816@docomonet.jp>
Date: Sun, 20 Sep 2026 10:15:57 +0900
Subject: [PATCH] video_driver: guard crt_switch_display_server_lost with
 HAVE_VIDEOCORE

crt_switch_display_server_lost() (video_crt_switch.c) is defined
inside #if !defined(HAVE_VIDEOCORE) - VideoCore keeps its own
tvservice path and doesn't use the modeline ops table. The call
added in 94d23651 (\"crt: rebind the modeline ops when the display
server is rebuilt under a live engine\") only checked HAVE_MODELINE,
so any build with both HAVE_MODELINE and HAVE_VIDEOCORE (e.g. Lakka
RPiZero/RPiZero2 with the bcm2835-driver GLES stack) fails to link:

  video_driver.c:(.text+0x20e8): undefined reference to
  \`crt_switch_display_server_lost'

Add the same !defined(HAVE_VIDEOCORE) guard at the call site.
---
 gfx/video_driver.c | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/gfx/video_driver.c b/gfx/video_driver.c
index 6d247c0f28..29850879c9 100644
--- a/gfx/video_driver.c
+++ b/gfx/video_driver.c
@@ -1728,7 +1728,7 @@ void video_display_server_destroy(void)
    if (current_display_server && (current_display_server != &dispserv_null))
       if (video_st->current_display_server_data)
       {
-#if defined(HAVE_MODELINE)
+#if defined(HAVE_MODELINE) && !defined(HAVE_VIDEOCORE)
          crt_switch_display_server_lost(&video_st->crt_switch_st,
                video_st->current_display_server_data);
 #endif
