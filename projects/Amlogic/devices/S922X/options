################################################################################
# setup device defaults
################################################################################

  # The TARGET_CPU variable controls which processor should be targeted for
  # generated code.
    case $TARGET_ARCH in
      aarch64)
        TARGET_CPU="cortex-a73.cortex-a53"
        TARGET_CPU_FLAGS="+crc+fp+simd"
        ;;
      arm)
        TARGET_KERNEL_ARCH="arm64"
        TARGET_FLOAT="hard"
        TARGET_CPU="cortex-a73.cortex-a53"
        TARGET_CPU_FLAGS="+crc"
        TARGET_FPU="neon-fp-armv8"
        ;;
    esac

  # U-Boot firmware package(s) to use
    UBOOT_FIRMWARE="amlogic-boot-fip"

  # Kernel to use
    LINUX="amlogic-s922x"

  # Kernel target
    KERNEL_TARGET="Image"

  # Displayserver to use (wl / x11 / no)
    DISPLAYSERVER="wl"

  # Windowmanager to use (fluxbox / sway / weston / no)
    WINDOWMANAGER="sway"

  # additional packages to install
    ADDITIONAL_PACKAGES+=" ogu-combo-gamepad odroidgou-volkeys"

  # kernel serial console
    EXTRA_CMDLINE="console=ttyGS0 console=tty0 systemd.debug_shell=ttyAML0 console=ttyAML0,115200n8"

  # OpenGL-ES implementation to use
    OPENGLES="mesa"

  # Graphic drivers to use
    GRAPHIC_DRIVERS="panfrost"

  # KODI Player implementation to use
    KODIPLAYER_DRIVER="$OPENGLES"

  # Set the addon project
    ADDON_PROJECT="ARMv8"
