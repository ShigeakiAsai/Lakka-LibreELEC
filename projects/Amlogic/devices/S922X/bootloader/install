echo "${BOOTLOADER}: installing u-boot.bin"

# Clean up after previous build
rm -rfv "${INSTALL}"/usr/share/bootloader/boot.ini
rm -rfv "${INSTALL}"/usr/share/bootloader/u-boot*

mkdir -p "${INSTALL}/usr/share/bootloader"

if [ -f "${PKG_BUILD}/sd_fuse/u-boot.bin" ]; then
  cp -av "${PKG_BUILD}/sd_fuse/u-boot.bin" "${INSTALL}/usr/share/bootloader"
fi
