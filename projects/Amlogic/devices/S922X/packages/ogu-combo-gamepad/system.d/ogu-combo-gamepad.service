[Unit]
Description=Merge ogu-adc-joystick and ogu-gpio-keys-gamepad into ogu-combo-gamepad
After=dev-input-by\x2dpath-platform\x2dogu\x2dadc\x2djoystick\x2devent\x2djoystick.device
Before=retroarch.service

[Service]
Type=notify
ExecStart=/usr/bin/evsieve \
  --input /dev/input/by-path/platform-ogu-adc-joystick-event-joystick grab persist=reopen \
  --input /dev/input/by-path/platform-ogu-gpio-keys-gamepad-event-joystick grab persist=reopen \
  --output name="ogu-combo-gamepad"
ExecStartPost=/bin/sh -c 'udevadm control --property=OGU_COMBO_ACTIVE=1 && udevadm trigger --action=change --name-match=/dev/input/by-path/platform-ogu-gpio-keys-gamepad-event-joystick'
Restart=on-failure
RestartSec=2
