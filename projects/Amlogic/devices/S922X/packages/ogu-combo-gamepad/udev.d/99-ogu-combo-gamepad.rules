# The raw "ogu-gpio-keys-gamepad" device is grabbed and merged with
# "ogu-adc-joystick" into "ogu-combo-gamepad" by the in-kernel
# ogu_combo_gamepad input handler. Hide the raw devices from RetroArch's
# udev joypad enumeration (which filters on ID_INPUT_JOYSTICK=1) so only
# the merged device is visible. The ODROID-GO Ultra always has analog
# sticks, so this rule is static and does not depend on grab timing.
SUBSYSTEM=="input", KERNEL=="event*", ATTRS{name}=="ogu-gpio-keys-gamepad", ENV{ID_INPUT_JOYSTICK}="0"
SUBSYSTEM=="input", KERNEL=="event*", ATTRS{name}=="ogu-adc-joystick", ENV{ID_INPUT_JOYSTICK}="0"
